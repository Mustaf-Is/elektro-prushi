---
import mark from '../assets/brand-mark-transparent.png';
---

<a class="brand" href="/">
  <img src={mark.src} width={mark.width} height={mark.height} alt="" />
  <span>
    ELEKTRO <strong>PRUSHI</strong>
    <small>ELEKTRO INSTALUES</small>
  </span>
</a>
<style>
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #fff;
    flex-shrink: 0;
  }
  .brand img {
    width: 65px;
    height: auto;
  }
  .brand span {
    font-size: 19px;
    letter-spacing: -0.7px;
    white-space: nowrap;
  }
  .brand strong {
    color: var(--yellow);
    font-weight: 800;
  }
  .brand small {
    display: block;
    letter-spacing: 3.2px;
    font-size: 8px;
    margin-top: 3px;
  }
  @media (max-width: 480px) {
    .brand img {
      width: 48px;
    }
    .brand span {
      font-size: 15px;
    }
    .brand small {
      font-size: 6px;
      letter-spacing: 2.5px;
    }
    .brand {
      gap: 8px;
    }
  }
</style>
