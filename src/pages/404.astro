---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Faqja nuk u gjet"
  description="Faqja që kërkoni nuk ekziston. Kthehuni te ballina e Elektro Prushi."
>
  <section class="section">
    <div class="container">
      <span class="eyebrow">GABIM 404</span>
      <h1>Një lidhje që mungon.</h1>
      <p>
        Faqja që kërkoni nuk u gjet. Mund të ktheheni te ballina ose të shihni
        shërbimet tona.
      </p>
      <a class="button primary" href="/">
        Kthehu në ballinë ↗
      </a>
    </div>
  </section>
</Layout>
